<div class="space-y-8">
  
  <!-- Hero Section & Title -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-2 border-b border-slate-800/60">
    <div>
      <h1 class="text-3xl font-extrabold font-outfit tracking-tight bg-gradient-to-r from-white via-slate-100 to-indigo-300 bg-clip-text text-transparent flex items-center gap-3">
        <span>✨ Task Master</span>
      </h1>
      <p class="mt-1 text-sm text-slate-400">
        오늘 해야 할 일을 등록하고, 체계적으로 목표를 달성해 보세요.
      </p>
    </div>
  </div>

  <!-- Progress Statistics Card -->
  <%= render "stats" %>

  <!-- Add New Todo Form Container -->
  <div class="bg-slate-900/60 backdrop-blur-xl border border-slate-800/80 rounded-2xl p-6 shadow-xl">
    <h2 class="text-base font-bold text-slate-200 mb-4 flex items-center space-x-2">
      <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      <span>새로운 할 일 등록</span>
    </h2>

    <div id="new_todo_form">
      <%= render "form", todo: @new_todo %>
    </div>
  </div>

  <!-- Filter & List Header -->
  <div class="space-y-4">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <h2 class="text-lg font-bold text-slate-200 font-outfit flex items-center space-x-2">
        <span>할 일 목록</span>
      </h2>

      <!-- Filter Tabs -->
      <div class="flex items-center space-x-1 bg-slate-900/80 p-1 rounded-xl border border-slate-800 self-start sm:self-auto">
        <%= link_to todos_path(filter: "all"), class: "px-3 py-1.5 rounded-lg text-xs font-semibold transition-all duration-200 #{@filter == 'all' ? 'bg-indigo-600 text-white shadow-sm' : 'text-slate-400 hover:text-slate-200 hover:bg-slate-800'}" do %>
          전체 보기
        <% end %>

        <%= link_to todos_path(filter: "active"), class: "px-3 py-1.5 rounded-lg text-xs font-semibold transition-all duration-200 #{@filter == 'active' ? 'bg-amber-600 text-white shadow-sm' : 'text-slate-400 hover:text-slate-200 hover:bg-slate-800'}" do %>
          진행 중만
        <% end %>

        <%= link_to todos_path(filter: "completed"), class: "px-3 py-1.5 rounded-lg text-xs font-semibold transition-all duration-200 #{@filter == 'completed' ? 'bg-emerald-600 text-white shadow-sm' : 'text-slate-400 hover:text-slate-200 hover:bg-slate-800'}" do %>
          완료된 항목
        <% end %>
      </div>
    </div>

    <!-- Todo List Container -->
    <div id="todos_list" class="space-y-3">
      <% if @todos.any? %>
        <% @todos.each do |todo| %>
          <%= render "todo", todo: todo %>
        <% end %>
      <% else %>
        <!-- Empty State -->
        <div id="empty_todos_state" class="py-14 px-4 text-center bg-slate-900/40 border border-slate-800/60 border-dashed rounded-2xl">
          <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-indigo-500/10 flex items-center justify-center text-indigo-400 border border-indigo-500/20">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-base font-semibold text-slate-300">등록된 할 일이 없습니다</h3>
          <p class="mt-1 text-xs text-slate-500 max-w-sm mx-auto">
            상단의 폼을 이용해 첫 번째 할 일을 작성하고 알찬 하루를 시작해 보세요!
          </p>
        </div>
      <% end %>
    </div>
  </div>

</div>
