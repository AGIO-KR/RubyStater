<%= form_with(model: todo, class: "space-y-4") do |f| %>
  <% if todo.errors.any? %>
    <div class="p-4 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-300 text-sm">
      <h4 class="font-semibold mb-1"><%= todo.errors.count %>개의 오류로 인해 저장할 수 없습니다:</h4>
      <ul class="list-disc list-inside space-y-1">
        <% todo.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Title Input -->
  <div>
    <%= f.label :title, "할 일 제목", class: "block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" %>
    <%= f.text_field :title, placeholder: "어떤 할 일이 있으신가요?", required: true, class: "w-full px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-700/80 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 text-sm transition-all" %>
  </div>

  <!-- Content Input -->
  <div>
    <%= f.label :content, "상세 내용 (선택)", class: "block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" %>
    <%= f.text_area :content, rows: 3, placeholder: "세부 내용이나 메모를 자유롭게 적어보세요.", class: "w-full px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-700/80 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 text-sm transition-all resize-none" %>
  </div>

  <!-- Due Date & Priority Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <!-- Due Date -->
    <div>
      <%= f.label :due_date, "마감일", class: "block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" %>
      <%= f.date_field :due_date, class: "w-full px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-700/80 text-white focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 text-sm transition-all" %>
    </div>

    <!-- Priority -->
    <div>
      <%= f.label :priority, "우선순위", class: "block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" %>
      <%= f.select :priority, Todo.priorities.keys.map { |p| [p == 'high' ? '🔥 높음' : (p == 'medium' ? '⚡ 보통' : '☕ 낮음'), p] }, {}, class: "w-full px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-700/80 text-white focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 text-sm transition-all" %>
    </div>
  </div>

  <!-- Action Buttons -->
  <div class="flex items-center justify-end space-x-3 pt-2">
    <% if todo.persisted? %>
      <%= link_to "취소", todos_path, class: "px-4 py-2 rounded-xl border border-slate-700 text-slate-300 hover:bg-slate-800 text-sm font-medium transition-colors" %>
    <% end %>

    <%= f.submit todo.persisted? ? "수정 완료" : "할 일 등록하기", class: "px-5 py-2.5 rounded-xl bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 hover:from-indigo-600 hover:to-pink-600 text-white font-semibold text-sm shadow-lg shadow-indigo-500/25 hover:shadow-indigo-500/40 transition-all transform active:scale-95 cursor-pointer" %>
  </div>
<% end %>
